<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto"
    tools:replace="android:installLocation">

    <!-- Horizon OS is Android, and a headset is a device with no telephony, no touchscreen
         and no Google Play services. Everything below says exactly that, so the store and
         the launcher can tell the truth about the app before a user installs it. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <!-- ================================================================================
         Permissions removed for Horizon OS, and this is a store-upload blocker rather
         than a style preference.

         Meta's porting guide: "A build that requests a prohibited permission fails store
         upload." Not review two weeks later — upload, in the first minute.
         (developers.meta.com/horizon/documentation/android-apps/port-an-existing-app,
          updated 2026-09-14; the list itself is at /resources/permissions-prohibited/,
          read 2026-09-21.)

         All eight below were found by intersecting that list with what this package
         actually requested — 65 permissions inherited from Telegram — rather than by
         guessing which ones looked risky.

         They are removed HERE, in the headset flavour only. Every phone flavour keeps
         its own manifest untouched, which is the product-flavor separation Meta's guide
         recommends for exactly this.

         What each one costs, so nobody restores one without knowing:
    ================================================================================ -->

    <!-- Contact sync and the invite-a-contact flow. A headset has no address book to
         sync with, and Horizon prohibits reading one. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" tools:node="remove" />

    <!-- The Android account system. Telegram uses it to put the account in Settings;
         Horizon does not have that surface. -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" tools:node="remove" />

    <!-- Telephony. A Quest has no SIM, no dialler and no number to read. These fed the
         phone-number guess on the sign-in screen, which on this device guessed nothing. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" tools:node="remove" />

    <!-- Live location sharing in the background. In a headset that does not leave the
         room, this is a permission with a cost and no use. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />

    <!-- Telegram's own in-app updater. A store build must never side-install an APK, and
         Meta names INSTALL_PACKAGES as its example of a dangerous permission. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <!-- Drawing over other apps — the picture-in-picture player. Inside a spatial shell
         that composites its own panels, this is both prohibited and meaningless. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />

    <!-- Dictation and voice messages. Declared here rather than inherited so the reason is
         visible in this file: the headset build asks for the microphone and nothing else new. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Identity. Upstream leaves the application element with no label and no icon, because
         each of its activity-aliases carries its own; the alias this build launches from is the
         default one, which carries neither. On a Quest that shows up as a nameless, iconless
         tile in the library - measured on a device, `aapt2 dump badging` printed
         `label='' icon=''`. Declared here, on the application, so every alias inherits it.
         The artwork is Nicegram's own, taken from the Nicegram Android client's
         `nicegram-features` module; provenance is recorded in NOTICE.md. The resource is the one
         that repository calls `ic_launcher_default`: Nicegram's own default icon, a white
         monogram on a black background (`ic_launcher_default_background` is `#000000`). The
         name is kept unchanged so the files trace back byte for byte. -->
    <application
        android:name="org.telegram.messenger.QuestApplicationLoader"
        android:label="@string/vr_app_name"
        android:icon="@mipmap/ic_launcher_default"
        android:roundIcon="@mipmap/ic_launcher_default_round"
        android:theme="@style/Theme.NicegramVR.Start"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        tools:replace="android:name,android:label,android:icon,android:roundIcon,android:theme">

        <!-- Portrait, and this line used to say landscape.

             The old comment read "the system owns the panel's size, the app must not fight it",
             which was true and was then used to justify the opposite: a hard landscape lock.
             Horizon OS sizes a 2D panel from the orientation the app declares, so declaring
             landscape is exactly how an app fights for a shape - and the shape it won was wrong.
             Measured on a Quest 3: the panel came up 1280x800, and a messenger drawn 665 dp wide
             puts one message on one long line and fits almost nothing top to bottom. A chat is a
             tall column of short lines; that is why every phone client is shaped like a phone.

             resizeableActivity stays true, so the panel is still the wearer's to resize - which
             is what "the system owns the size" was supposed to mean in the first place. -->
        <!-- Which headsets this app declares support for. Required by Horizon OS; without
             it the store has nothing to match against. -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|questpro|quest3|quest3s" />

        <activity
            android:name="org.telegram.ui.LaunchActivity"
            android:screenOrientation="portrait"
            android:resizeableActivity="true"
            android:exported="true"
            tools:replace="android:screenOrientation">

            <!-- The panel's initial size, declared rather than fought for.
                 This week was spent controlling the panel from the other end — locking
                 orientation, then re-basing the density ramp — because this declaration was
                 missing. Horizon sizes the window from here.

                 420x720 dp is a phone's shape, which is what a column of short lines wants.
                 At the measured system density of 1.25 that is 525x900 px. The floor stops
                 a resize from squeezing the composer into something unusable. -->
            <layout
                android:defaultWidth="420dp"
                android:defaultHeight="720dp"
                android:minWidth="360dp"
                android:minHeight="480dp" />
        </activity>
    </application>
</manifest>
