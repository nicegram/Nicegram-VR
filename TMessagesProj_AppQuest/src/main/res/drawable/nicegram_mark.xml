<?xml version="1.0" encoding="utf-8"?>
<!--
  Nicegram VR — the product's own mark, as a VECTOR and as a white glyph on nothing.

  It replaces five PNG files that were, at every density, a single flat colour: 32x32, 48x48,
  64x64, 96x96 and 128x128 of pure white and nothing else. They rendered as the white rectangle
  on the intro screen, and nothing in the build could notice — a blank image compiles, packs and
  draws exactly like a real one.

  Two properties this shape has to keep, both load-bearing:

  * WHITE, on a transparent background. DialogStoriesCell draws it under
    PorterDuff.Mode.MULTIPLY (:341) so the theme can colour it; multiplying anything but white
    throws the theme's colour away, and multiplying a gradient throws the gradient away too.
  * A VECTOR. It is drawn at 22dp in the stories row and at launcher sizes elsewhere, and a
    raster mark is one more set of five files to keep in step.

  The glyph is the same N as the launcher foreground, taken from it rather than redrawn:
  ic_launcher_default_foreground.xml, minus its black background square. The group below
  shifts the viewport onto the glyph's own bounds (212..812 of a 1024 box), so the mark fills
  its drawable instead of sitting in the launcher icon's safe-zone inset.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="600"
    android:viewportHeight="600">
    <group
        android:translateX="-212"
        android:translateY="-212">
        <path
            android:pathData="M735.6,361.7C776.9,361.7 810.4,328.2 810.4,286.9C810.4,245.5 776.9,212 735.6,212C694.3,212 660.8,245.5 660.8,286.9C660.8,328.2 694.3,361.7 735.6,361.7Z"
            android:fillColor="#FFFFFFFF"/>
        <path
