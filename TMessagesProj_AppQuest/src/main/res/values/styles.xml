<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Nicegram VR — the launch window.

      Upstream's Theme.TMessages.Start inherits Theme.AppCompat.Light and sets a WHITE window
      background, so every cold start flashes white before the first frame. On a phone that is a
      blink. In a headset it is a white panel at arm's length, usually in a dark room, in a
      client whose whole premise is staying quiet and dark — the device itself reports `night`.

      This is a NEW name rather than an override of upstream's. Redefining the same name was
      tried first and lost the resource merge: `aapt2 dump resources` on the built package still
      reported `parent=Theme.AppCompat.Light` with white backgrounds. Rather than argue with the
      merge, the headset manifest points `android:theme` at this style, which cannot be
      ambiguous and leaves upstream's own style untouched for every other flavour.
    -->
    <style name="Theme.NicegramVR.Start" parent="Theme.AppCompat">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorBackground">@color/vr_launch_background</item>
        <item name="android:windowBackground">@color/vr_launch_background</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
