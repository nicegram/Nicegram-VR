<?xml version="1.0" encoding="utf-8"?>
<!--
  Nicegram VR — strings of the headset build.

  They live in this module rather than in Telegram's strings.xml on purpose: upstream's file is
  synchronised from their cloud, so anything of ours added there is overwritten sooner or later.
  Here they are ordinary Android resources and localise the ordinary way.
-->
